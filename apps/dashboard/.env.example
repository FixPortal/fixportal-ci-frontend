# Origin of the CI backend snapshot API (no trailing slash).
# Empty string (default) uses relative URLs — works with any nginx /api/ proxy.
# Vite development only: set explicitly to reach a backend on a different origin.
# Cross-origin dev also needs the backend to allow-list this dev server:
# run it with Cors__AllowedOrigins__0=http://localhost:5173.
VITE_CI_API_BASE=
